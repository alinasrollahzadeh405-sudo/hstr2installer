#!/usr/bin/env bash
# hstr2installer - Hysteria 2 installer and administration utility.
# Based on the official Hysteria 2 documentation:
# https://v2.hysteria.network/

set -Eeuo pipefail
IFS=$'\n\t'

readonly SCRIPT_NAME="hstr2installer"
readonly CONFIG_DIR="/etc/hysteria"
readonly CONFIG_FILE="${CONFIG_DIR}/config.yaml"
readonly DOMAIN_FILE="${CONFIG_DIR}/domain"
readonly SERVICE_FILE="/etc/systemd/system/hysteria.service"
readonly BINARY_FILE="/usr/local/bin/hysteria"
readonly RELEASE_API="https://api.github.com/repos/apernet/hysteria/releases/latest"

log() {
  printf '\033[1;32m[%s]\033[0m %s\n' "${SCRIPT_NAME}" "$*"
}

warn() {
  printf '\033[1;33m[WARNING]\033[0m %s\n' "$*" >&2
}

die() {
  printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
  exit 1
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    die "This script must be run as root."
  fi
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

install_dependencies() {
  local -a packages=(curl wget jq qrencode certbot openssl)
  local manager=""
  local pkg

  for pkg in apt-get dnf yum apk pacman zypper; do
    if command_exists "${pkg}"; then
      manager="${pkg}"
      break
    fi
  done

  [[ -n "${manager}" ]] || die "No supported package manager found. Install curl, wget, jq, qrencode, certbot, and openssl manually."

  case "${manager}" in
    apt-get)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y "${packages[@]}"
      ;;
    dnf|yum)
      "${manager}" install -y "${packages[@]}"
      ;;
    apk)
      apk add --no-cache "${packages[@]}"
      ;;
    pacman)
      pacman -Sy --noconfirm "${packages[@]}"
      ;;
    zypper)
      zypper --non-interactive install -y "${packages[@]}"
      ;;
  esac
}

validate_domain() {
  local dmn="$1"
  if [[ ! "${dmn}" =~ ^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$ ]]; then
    die "Invalid domain name: ${dmn}"
  fi
}

read_domain() {
  local dmn=""

  if [[ -s "${DOMAIN_FILE}" ]]; then
    dmn="$(tr -d '\r' < "${DOMAIN_FILE}")"
  fi

  if [[ -z "${dmn}" ]]; then
    read -r -p "Enter your domain: " dmn
    validate_domain "${dmn}"
    printf '%s\n' "${dmn}" > "${DOMAIN_FILE}"
    chmod 600 "${DOMAIN_FILE}"
  fi

  printf '%s' "${dmn}"
}

architecture_asset() {
  case "$(uname -m)" in
    x86_64|amd64)
      printf '%s' "amd64"
      ;;
    aarch64|arm64)
      printf '%s' "arm64"
      ;;
    *)
      die "Unsupported CPU architecture: $(uname -m). Supported architectures are amd64 and arm64."
      ;;
  esac
}

fetch_hysteria_asset_url() {
  local asset_arch="$1"
  curl --fail --silent --show-error --location "${RELEASE_API}" \
    | jq -r --arg arch "${asset_arch}" '
        .assets[]
        | select(.name | test("hysteria-linux-" + $arch + "($|\\.tar\\.gz$|\\.zip$|\\.exe$)"))
        | .browser_download_url' \
    | head -n 1
}

install_hysteria_binary() {
  local asset_arch
  asset_arch="$(architecture_asset)"

  local download_url=""
  local tmp_file=""
  local tmp_dir=""
  local extracted_file=""

  download_url="$(fetch_hysteria_asset_url "${asset_arch}")" || die "Could not find the official Hysteria release asset for ${asset_arch}."
  [[ -n "${download_url}" ]] || die "No compatible Hysteria release asset was found for ${asset_arch}."

  tmp_file="$(mktemp)"
  tmp_dir="$(mktemp -d)"
  trap 'rm -f "${tmp_file}"; rm -rf "${tmp_dir}"' RETURN

  curl --fail --silent --show-error --location --output "${tmp_file}" "${download_url}"

  if [[ "${download_url}" == *.tar.gz ]]; then
    tar -xzf "${tmp_file}" -C "${tmp_dir}"
    extracted_file="$(find "${tmp_dir}" -type f -name hysteria -o -name 'hysteria.exe' | head -n 1)"
    [[ -n "${extracted_file}" ]] || die "Failed to extract the Hysteria binary from the downloaded archive."
    install -o root -g root -m 0755 "${extracted_file}" "${BINARY_FILE}"
  elif [[ "${download_url}" == *.zip ]]; then
    unzip -q "${tmp_file}" -d "${tmp_dir}"
    extracted_file="$(find "${tmp_dir}" -type f -name hysteria -o -name 'hysteria.exe' | head -n 1)"
    [[ -n "${extracted_file}" ]] || die "Failed to extract the Hysteria binary from the downloaded archive."
    install -o root -g root -m 0755 "${extracted_file}" "${BINARY_FILE}"
  else
    install -o root -g root -m 0755 "${tmp_file}" "${BINARY_FILE}"
  fi

  "${BINARY_FILE}" version >/dev/null 2>&1 || die "Downloaded Hysteria binary failed its self-check."
  log "Installed Hysteria 2 from the official GitHub release."
}

write_service() {
  cat > "${SERVICE_FILE}" <<'UNIT'
[Unit]
Description=Hysteria 2 Server
Documentation=https://v2.hysteria.network/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hysteria server -c /etc/hysteria/config.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
UNIT

  chmod 0644 "${SERVICE_FILE}"
  systemctl daemon-reload
  systemctl enable hysteria.service >/dev/null 2>&1 || true
}

write_config() {
  local dmn="$1"
  local port="$2"
  local up="$3"
  local down="$4"
  local auth_password="$5"
  local masquerade_type="$6"
  local masquerade_url="$7"
  local rewrite_host="$8"

  mkdir -p "${CONFIG_DIR}"

  cat > "${CONFIG_FILE}" <<EOF
# Generated by ${SCRIPT_NAME}; see https://v2.hysteria.network/
listen: :${port}
tls:
  cert: /etc/letsencrypt/live/${dmn}/fullchain.pem
  key: /etc/letsencrypt/live/${dmn}/privkey.pem
auth:
  type: password
  password: ${auth_password}
bandwidth:
  up: ${up}
  down: ${down}
EOF

  if [[ "${masquerade_type}" == "proxy" ]]; then
    cat >> "${CONFIG_FILE}" <<EOF
masquerade:
  type: proxy
  proxy:
    url: ${masquerade_url}
    rewriteHost: ${rewrite_host}
EOF
  else
    cat >> "${CONFIG_FILE}" <<'EOF'
masquerade:
  type: string
  string:
    content: Hysteria 2
    headers:
      content-type: text/plain
EOF
  fi

  chmod 600 "${CONFIG_FILE}"
  "${BINARY_FILE}" server --config "${CONFIG_FILE}" check || die "Generated Hysteria config is invalid. Fix the configuration and retry."
}

install_and_configure() {
  local preset=""
  local dmn=""
  local port="443"
  local up="0 mbps"
  local down="0 mbps"
  local auth_password=""
  local masquerade_type="proxy"
  local masquerade_url="https://www.bing.com/"
  local rewrite_host="true"

  dmn="$(read_domain)"

  printf '\nConfiguration Presets:\n  A) High Speed / Gaming\n  B) Stealth / Camouflage\n  C) Custom / Advanced\n'
  read -r -p "Choose a preset [A-C]: " preset
  preset="${preset^^}"

  case "${preset}" in
    A)
      port="443"
      up="0 mbps"
      down="0 mbps"
      masquerade_type="proxy"
      masquerade_url="https://www.bing.com/"
      rewrite_host="true"
      auth_password="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32)"
      ;;
    B)
      port="443"
      up="0 mbps"
      down="0 mbps"
      masquerade_type="proxy"
      masquerade_url="https://www.bing.com/"
      rewrite_host="true"
      auth_password="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32)"
      ;;
    C)
      read -r -p "Listening port [443]: " port
      port="${port:-443}"
      if [[ ! "${port}" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        die "Invalid listening port. Use a number between 1 and 65535."
      fi

      read -r -p "Upload limit (for unlimited use 0 mbps): " up
      read -r -p "Download limit (for unlimited use 0 mbps): " down
      up="${up:-0 mbps}"
      down="${down:-0 mbps}"

      read -r -p "Masquerade proxy URL [https://www.bing.com/]: " masquerade_url
      masquerade_url="${masquerade_url:-https://www.bing.com/}"
      masquerade_type="proxy"
      rewrite_host="true"

      read -r -s -p "Authentication password (blank to generate): " auth_password
      printf '\n'
      auth_password="${auth_password:-$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32)}"
      ;;
    *)
      die "Unknown preset."
      ;;
  esac

  install_dependencies
  install_hysteria_binary
  printf '%s\n' "${dmn}" > "${DOMAIN_FILE}"
  write_config "${dmn}" "${port}" "${up}" "${down}" "${auth_password}" "${masquerade_type}" "${masquerade_url}" "${rewrite_host}"
  write_service
  systemctl restart hysteria.service
  log "Hysteria 2 is configured and running."
  warn "Issue a certificate with option 2 before relying on the TLS paths in the generated config."
}

issue_certificate() {
  local dmn=""
  read -r -p "Enter your domain: " dmn
  validate_domain "${dmn}"
  mkdir -p "${CONFIG_DIR}"
  printf '%s\n' "${dmn}" > "${DOMAIN_FILE}"

  certbot certonly --standalone -d "${dmn}" --non-interactive --agree-tos -m admin@"${dmn}"

  [[ -f "${CONFIG_FILE}" ]] || die "${CONFIG_FILE} does not exist. Run option 1 first."

  sed -i -E "s|^  cert:.*$|  cert: /etc/letsencrypt/live/${dmn}/fullchain.pem|; s|^  key:.*$|  key: /etc/letsencrypt/live/${dmn}/privkey.pem|" "${CONFIG_FILE}"
  "${BINARY_FILE}" server --config "${CONFIG_FILE}" check || die "Updated config validation failed."
  systemctl daemon-reload
  systemctl reload hysteria.service 2>/dev/null || systemctl restart hysteria.service
  log "Certificate installed and Hysteria reloaded."
}

add_user() {
  local dmn=""
  local client_name=""
  local client_pass=""
  local uri=""

  [[ -f "${CONFIG_FILE}" ]] || die "Run option 1 first."

  dmn="$(read_domain)"
  read -r -p "Client identifier: " client_name
  [[ -n "${client_name}" ]] || die "Client identifier cannot be empty."

  read -r -s -p "Client password (blank to generate): " client_pass
  printf '\n'
  client_pass="${client_pass:-$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32)}"

  uri="hy2://${client_pass}@${dmn}:443/?insecure=0&sni=${dmn}#${client_name}"
  printf '\033[1;36m%s\033[0m\n' "${uri}"

  if command_exists qrencode; then
    qrencode -t ansiutf8 "${uri}"
  else
    warn "qrencode is not installed."
  fi

  warn "Store the generated password securely and ensure it matches the server auth settings."
}

manage_service() {
  local action=""

  printf '1) Start\n2) Stop\n3) Restart\n4) Status\n'
  read -r -p "Choose an action: " action

  case "${action}" in
    1)
      systemctl start hysteria.service
      ;;
    2)
      systemctl stop hysteria.service
      ;;
    3)
      systemctl restart hysteria.service
      ;;
    4)
      systemctl status --no-pager hysteria.service
      ;;
    *)
      die "Unknown service action."
      ;;
  esac
}

main() {
  local choice=""

  require_root

  while true; do
    printf '\n=== Hysteria 2 Installer ===\n'
    printf '1) Install & Auto-Configure Hysteria 2 (with Presets)\n'
    printf '2) Issue SSL Certificate (Certbot Standalone)\n'
    printf '3) Add User / Generate Client Config & QR Code\n'
    printf '4) Manage Service (Start/Stop/Restart/Status)\n'
    printf '5) Exit\n'
    read -r -p "Select an option [1-5]: " choice

    case "${choice}" in
      1)
        install_and_configure
        ;;
      2)
        issue_certificate
        ;;
      3)
        add_user
        ;;
      4)
        manage_service
        ;;
      5)
        exit 0
        ;;
      *)
        warn "Please choose a number from 1 to 5."
        ;;
    esac
  done
}

main "$@"
